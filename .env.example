# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Supabase dashboard → Project Settings → API Keys / Data API / Database.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Publishable key (sb_publishable_…). Kept server-side: the app does all auth
# through Server Actions, so no Supabase key is shipped to the browser.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_…). Bypasses RLS. Used only by the npm run db:* scripts.
SUPABASE_SECRET_KEY=

# Postgres connection string for migrations and checks. Use the "Session pooler"
# string from Connect → Connection string (works on IPv4 networks), with your
# database password filled in. Used only by the npm run db:* scripts.
SUPABASE_DB_URL=

# Super admin created by npm run db:seed. Must be changed at first sign-in.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
